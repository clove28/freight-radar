# 货运雷达 · 环境变量示例（复制为 .env 或直接 export）
# 复制：cp .env.example .env

# 端口（默认 3000）
# PORT=3000

# 高德 Web 服务 Key（免费申请：https://lbs.amap.com → 控制台 → 应用管理 → Web服务）
# 配置后启用真实路线/天气/POI；不配置则用 Mock 估算
# AMAP_KEY=你的高德key

# 持久化：1 启用 JSON 文件存储（重启不丢数据），默认关闭（内存 Mock）
PERSIST=1
# 数据目录（PERSIST=1 时生效）
DATA_DIR=./data

# 真实货源 API（可选，配置后 /api/cargos 从该地址拉货）
# CARGO_SOURCE=api
# CARGO_API_URL=https://your-cargo-api.example.com/cargos
# CARGO_API_KEY=xxx
# CARGO_API_TIMEOUT=8000

# 鉴权（P8）：1=强制登录（除白名单外所有业务 API 需 Bearer token），默认关闭（本地演示）
# 上线多用户时务必开启
# AUTH_REQUIRED=1

# 请求日志（P9）：1=控制台打印 方法 路径 状态码 耗时
# LOG_REQUESTS=1

# 短信服务商（P11）：默认演示（验证码直接返回）；生产配置 aliyun + 密钥
# SMS_PROVIDER=aliyun
# ALIYUN_SMS_ACCESS_KEY=xxx
# ALIYUN_SMS_SECRET=xxx
# ALIYUN_SMS_SIGN=xxx（短信签名）
# ALIYUN_SMS_TEMPLATE=xxx（验证码模板 Code）

# 行情指数 API（P11）：配置后 /api/quote 与货源价格标记用真实区间
# QUOTE_API_URL=https://your-quote-api.example.com
# QUOTE_API_KEY=xxx

# AI 引擎（P14）：配置 ARK_API_KEY 后 AI 助手用真实大模型（火山方舟），否则规则引擎
# ARK_API_KEY=ark-xxxxxxxx
# ARK_MODEL=ep-xxxxxxxx（火山方舟"推理接入点"ID，必填！用于 DeepSeek/豆包模型访问）
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 部署参考：Dockerfile + docker-compose.yml + deploy/nginx.conf.example + deploy/CHECKLIST.md
